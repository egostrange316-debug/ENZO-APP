# BOOK_CONCURRENCY=2           # bir vaqtda nechta kitob tahlil qilinadi
# BOOK_UPLOAD_DIR=             # vaqtinchalik papka (default: tizim tmp)
# GEMINI_GENERATE_TIMEOUT_MS=300000

# Talaffuz tekshirish (Gemini, faqat shu joyda AI ishlatiladi):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Sinf (avatar, uy vazifasi rasmi): doimiy disk papkasi (Render/Railway'da persistent volume ulang!)
# UPLOAD_DIR=/data/uploads
# IMAGE_MAX_MB=8
# Mavzuni o'zlashtirish chegarasi (birinchi urinishdagi to'g'ri javoblar %, standart 80)
# MASTERY_THRESHOLD_PERCENT=80

# Mashq bo'limi (ixtiyoriy)
# PRACTICE_SESSION_SIZE=10
# PRACTICE_CLEAR_STREAK=2
# PRACTICE_XP=5
